# Database (Neon recommended)
# Get from https://console.neon.tech → Connection string (pooled)
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Local alternative (docker compose)
# DATABASE_URL="postgresql://aether:aether@localhost:5432/aether_finance"

# Auth
JWT_SECRET="change-me-to-a-long-random-string-in-production"
JWT_EXPIRES_IN="7d"

# App
PORT=3000
NODE_ENV=development
CORS_ORIGIN="http://localhost:4200"

# Optional seed
SEED_DEMO_USER_EMAIL="demo@aether.finance"
SEED_DEMO_USER_PASSWORD="Demo123!"
